# Backend-only secrets. Copy this to `backend/.env` (gitignored) and fill in real values.
#
# This file is for secrets the BACKEND service owns and the apps must never see.
# The web app's public Firebase config lives in apps/web/.env.local (seed/count read that);
# do NOT put backend secrets there.

# Used by the venue activation sweeper's LLM content gate (Claude Haiku 4.5).
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Firebase Auth uid of the platform admin — seeded venues are owned by this user so they
# can be edited via the UI. Find yours in the Firebase console → Authentication → Users.
SEED_OWNER_UID=
