# ── Build-time (native compile only) ─────────────────────────────────────────
# Mapbox secret token (sk.*) — needed to download the Mapbox iOS/Android SDK
# during EAS Build or local native builds.
# Create one at mapbox.com → Account → Tokens → Create token (scope: DOWNLOADS:READ).
# Never commit this value.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=

# Mapbox — public token (pk.*) for map rendering at runtime
EXPO_PUBLIC_MAPBOX_TOKEN=

# Google Places API key — create a separate key from the web key
# Restrict it to this app's iOS bundle ID + Android package name in Google Cloud Console
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Set to "true" during local development to skip real Places API calls (no cost incurred)
# Remove or set to "false" for production builds
EXPO_PUBLIC_USE_MOCK_PLACES=true

# Firebase — copy from Firebase Console > Project Settings > Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
